# Copy to .env and set a unique password before starting the stack.
POSTGRES_PASSWORD=

# The browser UI is served from localhost:3000 by default.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional quality checker path inside the backend container.
REVIEW_PO_PATH=/opt/review-po-v3/review-po-v3.py
